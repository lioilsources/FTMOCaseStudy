diff --git a/tools/fillreplay/main.go b/tools/fillreplay/main.go
new file mode 100644
index 0000000..be4bd98
--- /dev/null
+++ b/tools/fillreplay/main.go
@@ -0,0 +1,30 @@
+// Command fillreplay re-applies a day of fills from a CSV export, for operations.
+package main
+
+import (
+	"encoding/csv"
+	"fmt"
+	"os"
+	"strconv"
+
+	"github.com/lioilsources/factory-gate/sample/orders"
+)
+
+func main() {
+	rows, err := csv.NewReader(os.Stdin).ReadAll()
+	if err != nil {
+		fmt.Fprintln(os.Stderr, err)
+		os.Exit(1)
+	}
+	e := orders.NewEngine(1_000_000)
+	for _, row := range rows {
+		if len(row) != 3 {
+			continue
+		}
+		q, _ := strconv.ParseInt(row[2], 10, 64)
+		if err := e.Apply(orders.Fill{FillID: row[0], OrderID: row[1], Quantity: q}); err != nil {
+			fmt.Fprintln(os.Stderr, row, err)
+		}
+	}
+	fmt.Printf("%+v\n", e.Account())
+}
