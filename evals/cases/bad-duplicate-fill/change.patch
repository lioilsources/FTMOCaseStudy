diff --git a/sample/orders/engine.go b/sample/orders/engine.go
index 9f3b325..a3203cb 100644
--- a/sample/orders/engine.go
+++ b/sample/orders/engine.go
@@ -9,11 +9,12 @@ import (
 type Engine struct {
 	account Account
 	orders  map[string]*Order
+	fills   map[string]bool // fill ids already applied
 }
 
 // NewEngine returns an engine whose account starts with the given balance.
 func NewEngine(balance int64) *Engine {
-	return &Engine{account: Account{Balance: balance}, orders: map[string]*Order{}}
+	return &Engine{account: Account{Balance: balance}, orders: map[string]*Order{}, fills: map[string]bool{}}
 }
 
 // Account returns a copy of the account.
@@ -72,7 +73,7 @@ func (e *Engine) place(ev PlaceOrder) error {
 	return nil
 }
 
-// fill accepts only a fill for the full remaining quantity.
+// fill accepts a fill for up to the remaining quantity. A fill id is applied at most once.
 func (e *Engine) fill(ev Fill) error {
 	if ev.FillID == "" || ev.Quantity <= 0 {
 		return fmt.Errorf("%w: %+v", ErrInvalidEvent, ev)
@@ -84,7 +85,7 @@ func (e *Engine) fill(ev Fill) error {
 	if o.Status != Open {
 		return fmt.Errorf("%w: %s is %s", ErrOrderNotOpen, o.ID, o.Status)
 	}
-	if ev.Quantity != o.Remaining() {
+	if ev.Quantity > o.Remaining() {
 		return fmt.Errorf("%w: got %d, remaining %d", ErrFillQuantity, ev.Quantity, o.Remaining())
 	}
 	value := ev.Quantity * o.Price
@@ -95,7 +96,10 @@ func (e *Engine) fill(ev Fill) error {
 		e.account.Balance += value
 	}
 	o.FilledQuantity += ev.Quantity
-	o.Status = Filled
+	if o.Remaining() == 0 {
+		o.Status = Filled
+	}
+	e.fills[ev.FillID] = true
 	return nil
 }
 
